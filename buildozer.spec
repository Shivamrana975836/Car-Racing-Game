[app]

# Application name
title = Car Racing Game

# Package name
package.name = carracinggame

# Package domain
package.domain = org.shivam

# Source code
source.dir = .

# Include game files and images
source.include_exts = py,png,jpg,jpeg,webp,txt

# Main python file
source.main = main.py

# Version
version = 1.0

# Requirements
requirements = python3,pygame,sdl2

# Screen orientation
orientation = landscape

# Full screen
fullscreen = 1


# Android settings
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a, armeabi-v7a


[buildozer]

# Build logs
log_level = 2
